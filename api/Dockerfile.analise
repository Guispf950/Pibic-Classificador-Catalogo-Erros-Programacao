# Dockerfile.analise — imagem do ambiente de análise isolado.
# Monta um Ubuntu com as ferramentas de análise dinâmica + Python e copia o pacote `src/` para
# dentro, de modo que a DETECÇÃO rode isolada, mas com exatamente o mesmo código do orquestrador.
#
# Contexto de build: precisa copiar `src/` (raiz do projeto) e `api/runner_analise.py`, então o
# build é feito A PARTIR DA RAIZ, apontando este arquivo com -f:
#     docker build -f api/Dockerfile.analise -t analise-mem:latest .
# (o "." final é o contexto = a raiz; sem isso o COPY de src/ falha.)

FROM ubuntu:22.04

# Ferramentas: gcc (compila C), gdb (Malha 1), valgrind (Malha 2), python3 (o runner).
# libc6-dev é essencial: traz os cabeçalhos da libc (stdio.h, stdlib.h, ...). Como o gcc apenas o
# RECOMENDA e usa-se --no-install-recommends, ele precisa ser listado à mão — senão o
# #include <stdio.h> falha com "fatal error: stdio.h: No such file or directory".
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gcc libc6-dev valgrind gdb libasan8 python3 && \
    rm -rf /var/lib/apt/lists/*

# Copia o pacote de detecção e o runner. Só a DETECÇÃO é usada aqui; llm_client/kb/cwe vêm junto
# em src/, mas o runner não os importa (o LLM roda no host). Copiar src/ inteiro mantém a imagem
# espelhando o src/ do projeto.
COPY src/ /app/src/
COPY api/runner_analise.py /app/runner_analise.py

# Usuário sem privilégios (uid 1000): o código do aluno nunca roda como root.
RUN useradd -m -u 1000 sandbox
USER sandbox

# CWD gravável em runtime: o contêiner sobe com --read-only + --tmpfs /tmp, então /tmp é o único
# lugar gravável. As malhas compilam ./bin_asan e ./bin_valgrind relativos ao CWD — com
# WORKDIR /tmp, caem no tmpfs.
WORKDIR /tmp

# ENTRYPOINT: roda quando o contêiner sobe. Recebe o caminho do .c como argumento (passado pelo
# `docker run ... /work/<arquivo>` montado pelo sandbox.py).
ENTRYPOINT ["python3", "/app/runner_analise.py"]
